# LiveKit egress config — fill in and load as the EGRESS_CONFIG_BODY secret
# (NOT committed with real values):
#   fly secrets set EGRESS_CONFIG_BODY="$(cat egress.yaml)" --app nextkey-livekit-egress

# Must match the SFU's key/secret (the same LIVEKIT_API_KEY / LIVEKIT_API_SECRET
# the CRM uses).
api_key: APIb5199261ab47
api_secret: <LIVEKIT_API_SECRET>

# The SFU's public signalling URL.
ws_url: wss://nextkey-livekit.fly.dev

# Message bus shared with the SFU. BOTH the SFU and egress must point at the
# SAME Redis, or egress requests never reach the recorder. Provision once (e.g.
# `fly redis create`, or Upstash) and set the SFU's livekit.yaml redis block too.
redis:
  address: <REDIS_HOST>:<PORT>
  username: default
  password: <REDIS_PASSWORD>
  db: 0

# Where finished recordings are uploaded. Supabase Storage is S3-compatible:
#   Dashboard -> Storage -> create a private bucket "recordings"
#   Dashboard -> Project Settings -> Storage -> S3 Access Keys -> generate
s3:
  access_key: <SUPABASE_S3_ACCESS_KEY_ID>
  secret: <SUPABASE_S3_SECRET_ACCESS_KEY>
  bucket: recordings
  region: <SUPABASE_REGION>            # e.g. ap-southeast-2
  endpoint: https://<PROJECT_REF>.storage.supabase.co/storage/v1/s3
  force_path_style: true

# Recording output tuning (optional).
logging:
  level: info
