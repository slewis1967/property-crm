# NextKey Property CRM — environment variable reference
#
# Copy to `.env.local` and fill in real values. `.env*` is gitignored.
# Grouped by: REQUIRED (app breaks without it) / RECOMMENDED /
# CONDITIONAL (only for a specific feature) / OPTIONAL (has a code default).
# Values shown are placeholders, NOT real secrets.

# ─────────────────────────────────────────────────────────────
# REQUIRED — core app
# ─────────────────────────────────────────────────────────────

# OpenRouter — ALL server-side AI: voice assistant (tool loop), /broadcast
# compliance review, deal-analyser research/parse, suburb + investment-case
# generation, and document extraction. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Model selection (OPTIONAL — sensible Claude-family defaults if unset).
# Verify exact slugs at https://openrouter.ai/models before overriding.
#   SMART = advisor-facing text + document extraction (default anthropic/claude-sonnet-4)
#   FAST  = voice loop, compliance, parse/research, CSV mapping (default anthropic/claude-haiku-4.5)
# To cut cost you can point FAST at e.g. openai/gpt-4o-mini or google/gemini-2.0-flash-001.
OPENROUTER_MODEL_SMART=
OPENROUTER_MODEL_FAST=

# Supabase — all property/contact data (new sb_ key format, not legacy JWT)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxx          # server-only, bypasses RLS

# NEXUS internal API (DuckDB proxy, sequence runner)
NEXUS_INTERNAL_API_KEY=xxxxxxxx

# Outbound SMS — ClickSend (voice send_sms tool)
CLICKSEND_USERNAME=you@example.com
CLICKSEND_API_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Outbound EMAIL — Brevo. WITHOUT THIS, ALL EMAIL IS DISABLED:
# voice send_email, /broadcast, /api/emails, draft sends all hard-fail
# ("BREVO_API_KEY missing — email feature disabled", utils/brevo.ts).
# In production this may instead be set in the Netlify dashboard.
BREVO_API_KEY=xkeysib-xxxxxxxx

# ─────────────────────────────────────────────────────────────
# RECOMMENDED
# ─────────────────────────────────────────────────────────────

# HMAC secret for broadcast compliance-override tokens.
# Falls back to SUPABASE_SERVICE_KEY if unset — set a dedicated random
# value (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# so the override secret is decoupled from the DB master key.
BROADCAST_REVIEW_SECRET=

# ─────────────────────────────────────────────────────────────
# CONDITIONAL — only needed for specific features / deploy modes
# ─────────────────────────────────────────────────────────────

# Auth gate. local = no auth (non-prod only); tunnel = require Cloudflare
# Access. Production ALWAYS enforces the tunnel regardless of this value.
AUTH_MODE=local

# Cloudflare Access service token — required only when NEXUS_API_BASE
# points at the PUBLIC tunnel (not for local dev against localhost:8765).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Cloudflare Access JWT verification. Without BOTH, proxy.ts falls back to
# forgeable header-presence trust (logged loudly). Set in production.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=

# Google OAuth — Calendar integration + Gmail-poll ingestion.
# utils/google-oauth.ts throws "Google OAuth not configured" without these.
# GMAIL_CLIENT_ID/SECRET are accepted as fallback aliases.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# NEXUS API base — defaults to http://localhost:8765 for local dev.
# Set to the public tunnel URL in production (then CF_ACCESS_* required).
NEXUS_API_BASE=http://localhost:8765

# OAuth redirect origin (Google). Needed if OAuth is used in production.
NEXT_PUBLIC_SITE_URL=https://crm.nextkey.com.au

# ─────────────────────────────────────────────────────────────
# OPTIONAL — all have safe code defaults; set to override
# ─────────────────────────────────────────────────────────────

# Email sender identity (defaults: info@nextkey.com.au /
# "NextKey Property Strategists" / sean.l@nextkey.com.au)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
NEXT_PUBLIC_BREVO_SENDER_EMAIL=

# Email signature block (utils/email-signature.ts)
SIGNATURE_NAME=
SIGNATURE_TITLE=
SIGNATURE_EMAIL=
SIGNATURE_PHONE=
SIGNATURE_WEB=
SIGNATURE_DISCLAIMER=

# Dev/auth helpers
DEV_USER_EMAIL=                                  # default sean.l@nextkey.com.au
TRUSTED_ORIGIN_HOSTS=                             # default crm.nextkey.com.au (CSRF allowlist, comma-sep)
